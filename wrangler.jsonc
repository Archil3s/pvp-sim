{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pvp-sim",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-23",
  "durable_objects": {
    "bindings": [
      {
        "name": "SUPERVISOR_HUB",
        "class_name": "SupervisorHub"
      }
    ]
  },
  "exports": {
    "SupervisorHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
